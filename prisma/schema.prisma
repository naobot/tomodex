generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DateFormat {
  DD_MONTH_YYYY // 25 June 2026
  MONTH_DD_YYYY // June 25, 2026
  DD_MM_YYYY    // 25/06/2026
  MM_DD_YYYY    // 06/25/2026
}

enum FriendsOrder {
  ADDED // by date added (default)
  ALPHA // alphabetical
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  // --- for NextAuth ---
  emailVerified DateTime?
  image         String?
  // --------------------------
  createdAt     DateTime  @default(now())

  // --- for NextAuth ---
  accounts Account[]
  // --------------------------

  settings                UserSettings?
  globalCustomFields      GlobalCustomField[]
  globalCustomFieldValues GlobalCustomFieldValue[]
  people                  Person[]
  notes                   Note[]
  customAttributes        CustomAttribute[]
  phoneNumbers            PhoneNumber[]
  emailAddresses          EmailAddress[]
  mailingAddresses        MailingAddress[]
  locations               Location[]
}

model GlobalCustomField {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  fieldType String   @default("TEXT")
  createdAt DateTime @default(now())

  values GlobalCustomFieldValue[]

  @@index([userId])
}

model GlobalCustomFieldValue {
  id        String            @id @default(cuid())
  ownerId   String
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  personId  String
  person    Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  fieldId   String
  field     GlobalCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value     String
  updatedAt DateTime          @updatedAt

  @@unique([personId, fieldId])
  @@index([personId])
}

model UserSettings {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateFormat   DateFormat   @default(DD_MONTH_YYYY)
  friendsOrder FriendsOrder @default(ADDED)
  updatedAt    DateTime     @updatedAt
}

// --- for NextAuth ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
}
// --------------------------

model Person {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  displayName String
  fullName    String?
  birthDay    Int?
  birthMonth  Int?
  birthYear   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phoneNumbers            PhoneNumber[]
  emailAddresses          EmailAddress[]
  mailingAddresses        MailingAddress[]
  location                Location?
  notes                   Note[]
  customAttributes        CustomAttribute[]
  globalCustomFieldValues GlobalCustomFieldValue[]

  @@index([ownerId])
  @@index([displayName])
  @@index([birthMonth])
}

// Renamed from Address — freeform postal/mailing address for letters and packages
model MailingAddress {
  id             String  @id @default(cuid())
  ownerId        String
  owner          User    @relation(fields: [ownerId], references: [id])
  personId       String
  person         Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  label          String?
  mailingAddress String
}

// One per person — where they currently live
model Location {
  id       String  @id @default(cuid())
  ownerId  String
  owner    User    @relation(fields: [ownerId], references: [id])
  personId String  @unique  // @unique enforces the one-to-one at the database level
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  city     String?
  country  String?
}

model PhoneNumber {
  id        String  @id @default(cuid())
  ownerId   String
  owner     User    @relation(fields: [ownerId], references: [id])
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  label     String?
  number    String
}

model EmailAddress {
  id        String  @id @default(cuid())
  ownerId   String
  owner     User    @relation(fields: [ownerId], references: [id])
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  label     String?
  address   String
}

model Note {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomAttribute {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
}